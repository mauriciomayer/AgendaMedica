<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required for auth-kt/postgrest-kt/functions-kt calls to the Supabase stack. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Optional GPS for ordering Busca results by distance (Story 2.1); manual search works without. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.AgendaMedica"
        android:usesCleartextTraffic="true">
        <!--
          usesCleartextTraffic is needed only because local Supabase (10.0.2.2, or a LAN IP
          for a physical device) is served over plain HTTP during development — per spec,
          "Ambiente de desenvolvimento é o Supabase local". Revisit before pointing at a
          cloud project (HTTPS), which is explicitly out of scope for this story.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.AgendaMedica">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="agendamedica" android:host="reset-password" />
            </intent-filter>
        </activity>
    </application>

</manifest>
